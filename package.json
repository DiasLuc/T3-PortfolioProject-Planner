{
  "name": "t3-planner-api",
  "version": "1.0.0",
  "description": "Daily Planner REST API built with Express and in-memory storage.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "mocha \"test/**/*.spec.js\" --require test/setup.js --reporter mochawesome --reporter-options reportDir=test-results/mochawesome,reportFilename=index,quiet=true,html=true,json=true",
    "test:spec": "mocha \"test/**/*.spec.js\" --require test/setup.js"
  },
  "keywords": [
    "express",
    "planner",
    "swagger",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "dotenv": "^17.2.3",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.3",
    "supertest": "^7.2.2"
  }
}
