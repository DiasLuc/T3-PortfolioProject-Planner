{
  "name": "t3-planner-api",
  "version": "1.0.0",
  "description": "Daily Planner REST API built with Express and in-memory storage.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:api": "node --watch src/server.js",
    "dev:web": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview:web": "vite preview --config vite.config.mjs",
    "test": "mocha \"test/**/*.spec.js\" --require test/setup.js --reporter mochawesome --reporter-options reportDir=test-results/mochawesome,reportFilename=index,quiet=true,html=true,json=true",
    "test:spec": "mocha \"test/**/*.spec.js\" --require test/setup.js"
  },
  "keywords": [
    "express",
    "planner",
    "swagger",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swagger-ui-express": "^5.0.1",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "dotenv": "^17.2.3",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.3",
    "supertest": "^7.2.2"
  }
}
